# Postgres connection string. On Supabase use the "Transaction pooler" URI (port 6543).
DATABASE_URL=postgres://acads:acads@localhost:5432/acads
# Long random text used to sign login cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me
# Used once by `npm run db:setup` to create your admin login.
ADMIN_USERNAME=rahul
ADMIN_PASSWORD=change-me
